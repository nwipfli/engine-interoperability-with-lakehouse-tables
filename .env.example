# ==============================================================================
# Lakehouse Cross-Engine Interoperability Demo - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the values for your Google Cloud project.
# Example: cp .env.example .env

# Google Cloud Project ID where resources will be provisioned
PROJECT_ID="your-project-id"

# Google Cloud Region for Lakehouse Catalog, BigQuery, and Dataproc resources
REGION="us-central1"

# Lakehouse Iceberg Catalog Name
CATALOG_NAME="engine_interoperability_demo"

# Cloud Storage Bucket Name for Lakehouse Iceberg Warehouse
# Note: Bucket name must be globally unique across GCP
WAREHOUSE_BUCKET="your-project-id-lakehouse-warehouse"

# User email address to grant necessary administrative IAM roles
USER_EMAIL="user@example.com"
